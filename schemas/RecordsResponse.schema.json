{
  "$defs": {
    "Record": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
          "title": "Id",
          "type": "string"
        },
        "company_id": {
          "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
          "title": "Company Id",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
          "title": "Product Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "dossier",
            "marketing",
            "customer_script",
            "evidence_index",
            "scientific_evidence",
            "label",
            "registration_receipt",
            "ad_confirmation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "access_groups": {
          "default": [
            "manager",
            "operations"
          ],
          "items": {
            "enum": [
              "manager",
              "operations"
            ],
            "type": "string"
          },
          "title": "Access Groups",
          "type": "array"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "company_id",
        "product_id",
        "kind",
        "title"
      ],
      "title": "Record",
      "type": "object"
    },
    "RecordVersion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
          "title": "Id",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
          "title": "Record Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "text": {
          "maxLength": 20000,
          "title": "Text",
          "type": "string"
        },
        "uses": {
          "default": [],
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Uses",
          "type": "array"
        },
        "reference_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
            "type": "string"
          },
          "title": "Reference Ids",
          "type": "array"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "confirmation_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmation Date"
        },
        "issuing_authority": {
          "default": "unknown",
          "enum": [
            "national_food_admin",
            "provincial_chair",
            "unknown"
          ],
          "title": "Issuing Authority",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        }
      },
      "required": [
        "id",
        "record_id",
        "version",
        "text",
        "received_at"
      ],
      "title": "RecordVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "records": {
      "items": {
        "$ref": "#/$defs/Record"
      },
      "title": "Records",
      "type": "array"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/RecordVersion"
      },
      "title": "Versions",
      "type": "array"
    }
  },
  "required": [
    "records",
    "versions"
  ],
  "title": "RecordsResponse",
  "type": "object"
}
