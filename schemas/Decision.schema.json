{
  "$defs": {
    "DecisionRequest": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
          "title": "Check Id",
          "type": "string"
        },
        "finding_id": {
          "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
          "title": "Finding Id",
          "type": "string"
        },
        "action": {
          "enum": [
            "confirm",
            "reject",
            "assign",
            "acknowledge",
            "close"
          ],
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "const": "reviewer",
          "title": "Actor",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "enum": [
                "marketing",
                "legal",
                "document_control"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "note": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "closure_check_id": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closure Check Id"
        },
        "internal_due_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Internal Due On"
        },
        "legal_due_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Due On"
        },
        "legal_clause_version_id": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Clause Version Id"
        },
        "legal_deadline_quote": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Deadline Quote"
        },
        "closure_conditions": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closure Conditions"
        },
        "closure_conditions_met": {
          "default": false,
          "title": "Closure Conditions Met",
          "type": "boolean"
        }
      },
      "required": [
        "check_id",
        "finding_id",
        "action",
        "actor",
        "note"
      ],
      "title": "DecisionRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
      "title": "Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/DecisionRequest"
    },
    "actor_user_id": {
      "default": "U-MANAGER",
      "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
      "title": "Actor User Id",
      "type": "string"
    },
    "task_status": {
      "enum": [
        "open",
        "assigned",
        "dismissed",
        "closed"
      ],
      "title": "Task Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "request",
    "task_status",
    "created_at"
  ],
  "title": "Decision",
  "type": "object"
}
