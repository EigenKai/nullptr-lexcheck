{
  "$defs": {
    "SystemScore": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "enum": [
            "keyword",
            "plain_chat",
            "lexcheck"
          ],
          "title": "System",
          "type": "string"
        },
        "evaluated_cases": {
          "minimum": 0,
          "title": "Evaluated Cases",
          "type": "integer"
        },
        "true_positive": {
          "minimum": 0,
          "title": "True Positive",
          "type": "integer"
        },
        "false_positive": {
          "minimum": 0,
          "title": "False Positive",
          "type": "integer"
        },
        "false_negative": {
          "minimum": 0,
          "title": "False Negative",
          "type": "integer"
        },
        "false_flags_on_clean": {
          "minimum": 0,
          "title": "False Flags On Clean",
          "type": "integer"
        },
        "precision": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision"
        },
        "recall": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recall"
        },
        "model_calls": {
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "failed_calls": {
          "minimum": 0,
          "title": "Failed Calls",
          "type": "integer"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "system",
        "evaluated_cases",
        "true_positive",
        "false_positive",
        "false_negative",
        "false_flags_on_clean",
        "model_calls",
        "failed_calls"
      ],
      "title": "SystemScore",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "phase": {
      "enum": [
        "bootstrap",
        "dev",
        "held_out"
      ],
      "title": "Phase",
      "type": "string"
    },
    "n": {
      "minimum": 0,
      "title": "N",
      "type": "integer"
    },
    "git_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Sha"
    },
    "dataset_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Sha256"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "rule_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
        "type": "string"
      },
      "title": "Rule Ids",
      "type": "array"
    },
    "systems": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SystemScore"
      },
      "title": "Systems",
      "type": "array"
    },
    "note": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "phase",
    "n",
    "note"
  ],
  "title": "EvaluationReport",
  "type": "object"
}
