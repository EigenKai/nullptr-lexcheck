{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "record_version_id": {
          "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
          "title": "Record Version Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "span",
            "missing_field",
            "cell",
            "page"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "cell": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        }
      },
      "required": [
        "record_version_id",
        "kind"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "clause_version_id": {
      "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
      "title": "Clause Version Id",
      "type": "string"
    },
    "quote": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Quote",
      "type": "string"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Evidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "clause_version_id",
    "quote"
  ],
  "title": "ChatCitation",
  "type": "object"
}
