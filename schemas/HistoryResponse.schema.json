    "Pattern": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
          "title": "Id",
          "type": "string"
        },
        "company_id": {
          "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
          "title": "Company Id",
          "type": "string"
        },
        "pack": {
          "const": "tpbvsk",
          "default": "tpbvsk",
          "title": "Pack",
          "type": "string"
        },
        "source_decision_id": {
          "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
          "title": "Source Decision Id",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "minimum": 1,
