    },
    "company_id": {
      "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
      "title": "Company Id",
      "type": "string"
    },
    "product_id": {
      "pattern": "^[A-Z][A-Za-z0-9-]{1,79}$",
      "title": "Product Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "dossier",
        "marketing",
        "customer_script",
